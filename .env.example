# Panel
PANEL_DOMAIN=:80
PANEL_BASE_PATH=/CHANGE_ME

# AWG container connection
AWG_CONTAINER=amnezia-awg2
AWG_CONFIG_PATH=/opt/amnezia/awg/awg0.conf
AWG_INTERFACE=awg0

# Public endpoint for client configs (host:port)
PUBLIC_ENDPOINT=

# Client defaults
DEFAULT_CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
DEFAULT_CLIENT_DNS=1.1.1.1, 8.8.8.8
