# Generated by install.sh. Sensitive settings are stored in .secrets.
# Optional: set a custom client name key for config files (FlammGuard)
CLIENT_NAME_KEY=Name
# Optional hardening: keep disabled unless you explicitly need restart controls from web panel.
ALLOW_CONTAINER_RESTART=false
# Optional hardening: keep disabled unless you explicitly need host reboot from web panel.
ALLOW_SYSTEM_REBOOT=false
